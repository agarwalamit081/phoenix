# Application
APP_NAME=phoenix-ai-travel-companion
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://ai_travel_companion:trainer@localhost:5432/ai_travel_companion
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_DECODE_RESPONSES=true

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_DATABASE=neo4j

# ==========================================
# PRIMARY LLM PROVIDERS
# ==========================================

# OpenAI (Primary for chat and embeddings)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENAI_MODEL_COMPLEX=gpt-4o
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# Google Gemini (Alternative LLM)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-exp

# DeepSeek (Alternative LLM)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# GLM (Zhipu AI - Alternative LLM)
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4-flash

# Cohere (Alternative for embeddings and text generation)
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL_EMBEDDING=embed-v3.0
COHERE_MODEL_CHAT=command-r-plus

# ==========================================
# AI AGENT & PLANNING
# ==========================================

# Voyage AI (Route planning optimization)
VOYAGE_API_KEY=your_voyage_api_key_here

# Backboard (Agent planning backend)
BACKBOARD_API_KEY=your_backboard_api_key_here

# ==========================================
# VOICE & AUDIO
# ==========================================

# Speechmatics (Speech-to-Text)
SPEECHMATICS_API_KEY=your_speechmatics_api_key_here
SPEECHMATICS_WS_URL=wss://flow.speechmatics.com/v1
SPEECHMATICS_AUTO_DETECT=true
SPEECHMATICS_LANGUAGE=en

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE=Rachel

# LiveKit (Real-time voice communication)
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_URL=wss://your-livekit-host.example.com

# ==========================================
# SEARCH & DISCOVERY
# ==========================================

# Tavily (AI-powered search)
TAVILY_API_KEY=your_tavily_api_key_here

# SerpApi (Google Search results)
SERPAPI_API_KEY=your_serpapi_api_key_here

# ==========================================
# MAP INTEGRATION (MCP)
# ==========================================

# Google Maps via Composio MCP
# MCP configured at: platform.composio.dev/ (mcp-config-ejbf90)
# Maps are accessed through the MCP server, no direct API key needed
MAP_PROVIDER=mcp
MCP_SERVER_URL=http://localhost:3000/mcp

# Fallback: Direct Google Maps API (if MCP unavailable)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ==========================================
# SECURITY
# ==========================================

SECRET_KEY=your_secret_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth (Optional - if not provided, only email/password auth available)
# GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
# APPLE_OAUTH_CLIENT_ID=your_apple_oauth_client_id
# APPLE_OAUTH_TEAM_ID=your_apple_team_id
# APPLE_OAUTH_KEY_ID=your_apple_key_id
# APPLE_OAUTH_PRIVATE_KEY=your_apple_private_key

# ==========================================
# CORS
# ==========================================

CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ==========================================
# RATE LIMITING
# ==========================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
RATE_LIMIT_REDIS_PREFIX=rate_limit

# ==========================================
# FEATURE FLAGS
# ==========================================

ENABLE_VOICE=true
ENABLE_TRANSLATION=true
ENABLE_SOCIAL_INTELLIGENCE=false  # Disabled - requires Reddit/Twitter API keys
ENABLE_GUIDED_TOUR=true
ENABLE_ROUTE_OPTIMIZATION=true

# ==========================================
# VOICE SETTINGS
# ==========================================

SUPPORTED_LANGUAGES=en,zh,ja,ko,hi,fr
DEFAULT_LANGUAGE=en
VOICE_ACTIVITY_DETECTION=true
SPEAKER_DIARIZATION=true

# ==========================================
# TRANSLATION SETTINGS
# ==========================================

TRANSLATION_CACHE_TTL=86400
TRANSLATION_BATCH_SIZE=10

# ==========================================
# ROUTE PLANNING
# ==========================================

ROUTE_MAX_POIS=20
ROUTE_MAX_DISTANCE_KM=50
ROUTE_OPTIMIZATION_TIMEOUT=30

# ==========================================
# TOUR SETTINGS
# ==========================================

TOUR_PROXIMITY_THRESHOLD_METERS=50
TOUR_STATE_SYNC_INTERVAL_SECONDS=5
TOUR_AUTO_RESUME_MINUTES=10

# Social Intelligence (Disabled - requires API keys)
# SOCIAL_REDDIT_CLIENT_ID=your_reddit_client_id
# SOCIAL_REDDIT_CLIENT_SECRET=your_reddit_client_secret
# SOCIAL_TWITTER_BEARER_TOKEN=your_twitter_bearer_token
SOCIAL_SIGNAL_CACHE_TTL=900
SOCIAL_UPDATE_INTERVAL_MINUTES=15

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=logs/phoenix.log
LOG_ROTATION=100 MB
LOG_RETENTION=30 days

# ==========================================
# MONITORING
# ==========================================

METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30

# ==========================================
# PERFORMANCE
# ==========================================

CACHE_DEFAULT_TTL=3600
CACHE_MAX_SIZE=10000
CONNECTION_TIMEOUT=30
READ_TIMEOUT=60
WRITE_TIMEOUT=60

# ==========================================
# TESTING
# ==========================================

TEST_DATABASE_URL=postgresql+asyncpg://ai_travel_companion:trainer@localhost:5432/ai_travel_companion_test
TEST_REDIS_URL=redis://localhost:6379/1
TEST_NEO4J_URI=bolt://localhost:7687
TEST_NEO4J_USER=neo4j
TEST_NEO4J_PASSWORD=neo4j
