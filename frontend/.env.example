# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_VERSION=v1
VITE_WS_BASE_URL=ws://localhost:8000

# Feature Flags
VITE_ENABLE_VOICE=true
VITE_ENABLE_TRANSLATION=true
VITE_ENABLE_SOCIAL_INTELLIGENCE=false
VITE_ENABLE_GUIDED_TOUR=true

# Map Configuration
VITE_MAP_PROVIDER=mapbox
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Analytics (Optional)
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_ID=
